# =============================================================================
# RelayFiles environment template
#
# 1. Copy this file:      cp .env.example .env        (development may also use .env.local)
# 2. Generate secrets:    npm run env:secrets         (prints values; paste them below)
# 3. Validate:            npm run env:check
#
# Never commit .env. Every key is validated by src/config/env.ts.
# An empty value means "use the default" shown in the comment.
# Docker Compose and Next.js both expand ${VAR} references inside this file.
# =============================================================================

# --- app ---------------------------------------------------------------------
# development | test | production (production masks errors and logs warn+ only)
NODE_ENV=development
# Address and port the app server listens on (Compose and Nginx use the same values).
# 127.0.0.1 keeps the app reachable only through Nginx, which is what makes the client address
# headers trustworthy (docker compose sets its own bind address). Use 0.0.0.0 only to open
# `npm run start` to the LAN for testing. Browsers refuse some ports (6000, 6665-6669, 10080,
# ...), so such a port must only be reached through Nginx.
APP_HOST=127.0.0.1
APP_PORT=3000
# Public origin used in share links, e.g. https://files.example.com
PUBLIC_URL=http://localhost:3000
# Default theme: blue | lime | coral | amber | teal | mono | plum | crimson | forest | sky
DEFAULT_THEME=sky
# Shown on the Status page
SERVER_LOCATION=Seoul, KR
# Expose the /dev/ui component catalog (keep false in production)
ENABLE_UI_CATALOG=false
# Client IPs are read from CF-Connecting-IP / X-Real-IP set by Nginx, so the app port must only be
# reachable through Nginx (bind APP_HOST to 127.0.0.1 or the Docker network).
# Restrict admin pages and APIs to these networks, e.g. 192.168.0.0/24 (empty = no restriction)
ADMIN_ALLOWED_CIDRS=
# Content-Security-Policy: report-only (violations are logged, nothing is blocked) or enforce
CSP_MODE=report-only
# Strict-Transport-Security, sent only when PUBLIC_URL is https. 0 turns it off (for example when
# Cloudflare already sends it). includeSubDomains only when every subdomain is https as well.
HSTS_MAX_AGE_SEC=31536000
HSTS_INCLUDE_SUBDOMAINS=false

# --- database (PostgreSQL 16) -----------------------------------------------------
# Inside Docker Compose use POSTGRES_HOST=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=relayfiles
POSTGRES_USER=relayfiles
# Required. At least 16 characters (npm run env:secrets)
POSTGRES_PASSWORD=
# Host address:port Compose publishes PostgreSQL on (keep it on 127.0.0.1)
POSTGRES_PUBLISH=127.0.0.1:5432
# Built from the values above; change only to point at an external database
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# --- redis (Redis 7: cache, sessions, rate limits, job queue) -----------------------
# Inside Docker Compose use REDIS_HOST=redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Required. At least 16 characters (npm run env:secrets)
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PUBLISH=127.0.0.1:6379
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
# Cache key prefix; bump the version (rf:v2:) when the cache format changes
REDIS_KEY_PREFIX=rf:v1:

# --- storage (external SSD) ---------------------------------------------------------
# Where user files live. Production: /mnt/relayfilesDB (LUKS2-encrypted SSD).
# A relative path is resolved from the repository root.
STORAGE_ROOT=./.data/relayfilesDB
# Free space kept on each volume (percent); uploads are refused below it
STORAGE_RESERVE_PERCENT=5
# System account that owns the files and runs the containers
STORAGE_UID=10001
STORAGE_GID=10001
# Let Nginx send files via X-Accel-Redirect (true in production behind Nginx)
STORAGE_ACCEL_ENABLED=false
STORAGE_ACCEL_PREFIX=/_protected/
# How often the SSD mount marker is checked (seconds)
VOLUME_WATCH_INTERVAL_SEC=30
# Copies and re-uploads of a file already in the account share its bytes on disk (hard links; the
# storage limit still counts every copy). false: every copy takes its own space
STORAGE_DEDUPE=true

# --- uploads ----------------------------------------------------------------
# Resumable upload chunk size in MB (must stay below Cloudflare's 100 MB limit)
UPLOAD_CHUNK_SIZE_MB=50
# Maximum size of a single file in GB (empty = no limit beyond the account quota)
UPLOAD_MAX_FILE_SIZE_GB=
# Incomplete uploads older than this are removed (hours)
UPLOAD_TMP_TTL_HOURS=6

# --- secrets (required; generate with npm run env:secrets) ---------------------------
# 32 random bytes, base64: encrypts account tokens at rest
TOKEN_ENC_KEY=
# At least 32 characters: HMAC used to look up tokens
TOKEN_HMAC_KEY=
# At least 32 characters: signs session cookies
COOKIE_SECRET=
# Set only while rotating keys (docs/runbook.md): the previous values stay readable
TOKEN_ENC_KEY_PREVIOUS=
TOKEN_HMAC_KEY_PREVIOUS=
COOKIE_SECRET_PREVIOUS=

# --- policy -------------------------------------------------------------------
# Member accounts are deleted with their files this many days after creation
ACCOUNT_TTL_DAYS=14
# Storage quota for new accounts in GB
DEFAULT_QUOTA_GB=5
# Total storage all anonymous accounts may use together in GB, counting uploads in progress
# (empty = no total limit; set it below the SSD size when sign-ups are open)
ANON_TOTAL_QUOTA_GB=
# Failed sign-in attempts before a lockout, and lockout lengths in seconds
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=30,120,600
# Anonymous accounts one client address may create per hour
SIGNUPS_PER_HOUR=10

# --- jobs ---------------------------------------------------------------------
# Daily cleanup schedule (cron) and the time zone it runs in
CLEANUP_CRON=0 4 * * *
JOBS_TIMEZONE=Asia/Seoul
METRICS_SAMPLE_INTERVAL_SEC=60
HEALTH_PROBE_INTERVAL_SEC=60
# Where the worker reaches the app for Status page probes
# (empty = http://127.0.0.1:APP_PORT; in docker compose: http://app:3000)
HEALTH_PROBE_URL=
# Thumbnails and metadata-stripped copies processed at once by the worker (npm run worker)
MEDIA_WORKER_CONCURRENCY=2
# ffmpeg binary for video thumbnails and in-viewer conversion (apt install ffmpeg)
FFMPEG_PATH=ffmpeg
# Videos browsers can't play (AVI, WMV, MPEG-TS, ...) are converted to 720p MP4 while they play.
# Conversions running at once in the app (CPU-heavy); 0 turns conversion off
VIDEO_TRANSCODE_MAX=2

# --- observability -------------------------------------------------------------
# error | warn | info | debug (empty = warn in production, debug otherwise)
LOG_LEVEL=
# File log directory in production (development logs to the console only)
LOG_DIR=/var/log/relayfiles
# Log file prefix per process (app-*.log, worker-*.log, tools-*.log). Leave empty: the worker and
# the npm scripts set it themselves
LOG_SERVICE=
# Disk shown as "Disk health" on the Server page (SMART)
DISK_DEVICE=/dev/sda
# Certificate whose expiry date is shown on the Status page (optional)
TLS_CERT_PATH=

# --- deploy (Nginx / Cloudflare Tunnel) ---------------------------------------------
SERVER_NAME=localhost
# Host address the compose Nginx is published on: 127.0.0.1 when a host Nginx sits in front of it
NGINX_LISTEN_HOST=0.0.0.0
NGINX_LISTEN_PORT=80
# Nginx request limits (compose and host templates): largest request body in MB (above
# UPLOAD_CHUNK_SIZE_MB), and per client address the sign-in and upload-start requests per minute
# with the burst allowed above that rate
NGINX_MAX_BODY_MB=100
NGINX_AUTH_RATE_PER_MIN=20
NGINX_AUTH_BURST=20
NGINX_UPLOAD_RATE_PER_MIN=60
NGINX_UPLOAD_BURST=30
# Only when running cloudflared from docker-compose (optional)
CLOUDFLARE_TUNNEL_TOKEN=
# Host directory for PostgreSQL data, Redis data and database backups. Keep it on the storage disk
# next to STORAGE_ROOT and LOG_DIR so the whole service moves with the disk
DATA_DIR=/srv/relayfiles
# Docker's data-root (images, containers, build cache); deploy/scripts/setup-docker.sh writes it to
# /etc/docker/daemon.json
DOCKER_DATA_ROOT=/var/lib/docker
# Private network of the compose services; cloudflared gets the fixed address below and is the
# only peer Nginx accepts a client address (CF-Connecting-IP) from
DOCKER_SUBNET=172.28.0.0/24
CLOUDFLARED_IP=172.28.0.250
# Behind a host Nginx (NGINX_LISTEN_HOST=127.0.0.1): the DOCKER_SUBNET gateway (172.28.0.1 for the
# subnet above), the peer the compose Nginx sees for it. Its X-Real-IP is then taken as the client
# address. Empty: no host proxy is trusted
TRUSTED_PROXY_IP=
# Container log rotation for every compose service: size per file (k/m/g) and files kept
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5
# Memory (K/M/G) and CPU cores the app and the worker may each use, in compose and systemd. Keeps a
# runaway video conversion or thumbnail job from starving PostgreSQL (N95: 16 GB, 4 cores)
APP_MEMORY_MAX=2G
APP_CPUS=3
WORKER_MEMORY_MAX=2G
WORKER_CPUS=2

# --- offsite backup (restic; deploy/scripts/offsite-backup.sh, docs/runbook.md "오프사이트 백업") ---
# restic repository, e.g. Cloudflare R2: s3:https://<account id>.r2.cloudflarestorage.com/<bucket>/relayfiles
# or Backblaze B2 (S3 API): s3:https://s3.<region>.backblazeb2.com/<bucket>/relayfiles. Empty: no offsite backup
RESTIC_REPOSITORY=
# Encrypts every offsite copy (at least 16 characters, npm run env:secrets prints one). Without it the
# backup cannot be read: keep a copy outside this server, e.g. in a password manager
RESTIC_PASSWORD=
# S3 access key of the bucket (R2: an API token with Object Read & Write on that bucket only)
OFFSITE_ACCESS_KEY_ID=
OFFSITE_SECRET_ACCESS_KEY=
# Snapshots kept after each run (newest per day, week, month)
OFFSITE_KEEP_DAILY=7
OFFSITE_KEEP_WEEKLY=4
OFFSITE_KEEP_MONTHLY=6
# Percent of the repository data the weekly backup check downloads and verifies
OFFSITE_CHECK_PERCENT=5
# More directories to back up, space-separated: the users/ folder of each extra volume
OFFSITE_EXTRA_PATHS=

# --- testing (not needed on the server) --------------------------------------------
E2E_PORT=3100
E2E_BASE_URL=
PLAYWRIGHT_CHROMIUM_PATH=
