# RelayFiles environment template — copy to .env.local (dev) or .env.production (server).
# Never commit real values. Keys are validated by src/config/env.ts.

# development | test | production
NODE_ENV=development

# Public origin used for share links (https://files.example.com in production)
PUBLIC_URL=http://localhost:3000

# Default color theme: blue | lime | coral | amber | teal | mono | plum | crimson | forest | sky
DEFAULT_THEME=sky

# Optional: error | warn | info | debug (default: warn in production, debug otherwise)
LOG_LEVEL=

# --- Added in later milestones (see docs/plan.md) ---
# M2: DATABASE_URL, REDIS_URL, STORAGE_ROOT (/mnt/relayfilesDB in production)
# M3: KEYS_JSON, ACTIVE_KEY_ID (token encryption / HMAC / cookie signing keys)
