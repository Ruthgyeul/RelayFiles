# RelayFiles background worker: thumbnails, metadata-stripped copies, cleanup, metrics and
# Status page probes. Rendered by deploy/scripts/systemd/install.sh.
[Unit]
Description=RelayFiles worker
Documentation=file://${APP_DIR}/docs/deploy-systemd.md
After=network-online.target postgresql.service redis-server.service relayfiles-app.service
Wants=network-online.target

[Service]
Type=simple
User=${STORAGE_USER}
Group=${STORAGE_USER}
WorkingDirectory=${APP_DIR}
Environment=HOME=${STORAGE_HOME}
# One Node process: tsx is loaded as a hook (the tsx CLI would start a second Node process).
ExecStart=${NODE_BIN} --import tsx --conditions=react-server scripts/worker.mts
UMask=0077
Restart=on-failure
RestartSec=5
# SIGTERM to Node only (KillMode=mixed, as tini does in the container) lets running jobs
# (thumbnails and their ffmpeg, cleanup) finish before the worker exits; whatever is left after
# WORKER_STOP_GRACE_SEC is killed.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=${STOP_GRACE_SEC}
NoNewPrivileges=true
# Resource limits (APP_/WORKER_MEMORY_MAX, _CPUS in .env): a runaway ffmpeg conversion or
# thumbnail job hits this service's own limit instead of starving PostgreSQL.
MemoryMax=${MEMORY_MAX}
CPUQuota=${CPU_QUOTA}
TasksMax=512
PrivateTmp=true
# Read-only everywhere except the SSD, the log directory, the service home and (app) the
# release bundles' .next/cache. An extra SSD needs its own line: sudo systemctl edit <unit>,
# [Service] ReadWritePaths=<mount> (docs/deploy-systemd.md).
ProtectSystem=strict
ReadWritePaths=${STORAGE_ROOT} ${LOG_DIR} ${STORAGE_HOME}
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
# No capabilities, not even for programs it starts (the service runs as an unprivileged user).
CapabilityBoundingSet=
AmbientCapabilities=
# Other users' processes are hidden in /proc (/proc/stat and /proc/meminfo for metrics stay).
ProtectProc=invisible
RemoveIPC=true
# The system calls an ordinary service makes; anything else fails with EPERM (libuv then falls
# back from io_uring to its thread pool).
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# The worker needs no device files (thumbnails and conversions read the SSD's files, not the disk).
PrivateDevices=true

[Install]
WantedBy=multi-user.target
