# RelayFiles web app (Next.js standalone). Rendered by deploy/scripts/systemd/install.sh;
# edit the template, not /etc/systemd/system/relayfiles-app.service.
[Unit]
Description=RelayFiles web app
Documentation=file://${APP_DIR}/docs/deploy-systemd.md
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=${STORAGE_USER}
Group=${STORAGE_USER}
WorkingDirectory=${APP_DIR}
Environment=HOME=${STORAGE_HOME}
# The release script points .app/current at the bundle of the running release.
ExecStart=${NODE_BIN} ${APP_DIR}/scripts/start-server.mjs ${APP_DIR}/.app/current
# Files and folders written to the SSD stay private to the storage account (0600 / 0700).
UMask=0077
Restart=on-failure
RestartSec=5
# Stopping: SIGTERM to Node only (KillMode=mixed, as tini does in the container), which stops
# accepting connections and finishes the requests in flight (streams, zips, upload chunks, and
# their ffmpeg children); whatever is left after APP_STOP_GRACE_SEC is killed. Next.js exits with
# 143 after a SIGTERM, which is a clean stop, not a failure.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=${STOP_GRACE_SEC}
SuccessExitStatus=143
NoNewPrivileges=true
# Resource limits (APP_/WORKER_MEMORY_MAX, _CPUS in .env): a runaway ffmpeg conversion or
# thumbnail job hits this service's own limit instead of starving PostgreSQL.
MemoryMax=${MEMORY_MAX}
CPUQuota=${CPU_QUOTA}
TasksMax=512
PrivateTmp=true
# Read-only everywhere except the SSD, the log directory, the service home and (app) the
# release bundles' .next/cache. An extra SSD needs its own line: sudo systemctl edit <unit>,
# [Service] ReadWritePaths=<mount> (docs/deploy-systemd.md).
ProtectSystem=strict
ReadWritePaths=${STORAGE_ROOT} ${LOG_DIR} ${STORAGE_HOME} ${APP_DIR}/.app
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
