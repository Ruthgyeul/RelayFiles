# RelayFiles behind Nginx (rendered by the nginx image's envsubst at start-up; values come
# from .env through docker compose). Nginx variables ($host, $1, …) are left untouched.

# Docker's DNS: the app container gets a new address whenever a release recreates it, so
# the upstream is resolved again instead of being fixed at start-up.
resolver 127.0.0.11 valid=10s ipv6=off;

upstream relayfiles_app {
    zone relayfiles_app 64k;
    server ${APP_UPSTREAM} resolve;
    keepalive 16;
}

# The real client address: only cloudflared (fixed address on the compose network) may
# set it through CF-Connecting-IP. Everyone else is identified by the TCP peer.
set_real_ip_from ${CLOUDFLARED_IP};
real_ip_header CF-Connecting-IP;

# A proxy on the host (host Nginx → NGINX_LISTEN_HOST:NGINX_LISTEN_PORT) reaches this container
# from the Docker gateway. Only that peer (TRUSTED_PROXY_IP) may name the client through
# X-Real-IP; the header from any other peer is ignored.
geo $realip_remote_addr $relay_from_host_proxy {
    default 0;
    ${TRUSTED_PROXY_IP} 1;
}
map "$relay_from_host_proxy|$http_x_real_ip" $relay_client_ip {
    "~^1\|(?<client>[0-9A-Fa-f.:]+)$" $client;
    default $remote_addr;
}

# The scheme the visitor used: only cloudflared and the trusted host proxy may say it through
# X-Forwarded-Proto (the app and tus build URLs from it); anyone else gets this hop's scheme.
geo $realip_remote_addr $relay_trusted_peer {
    default 0;
    ${CLOUDFLARED_IP} 1;
    ${TRUSTED_PROXY_IP} 1;
}
map "$relay_trusted_peer|$http_x_forwarded_proto" $relay_proto {
    "~^1\|(?<proto>https?)$" $proto;
    default $scheme;
}

# First line of defense before the app's own Redis limits (and before argon2 checks link
# passwords): sign-in, sign-up, account switching, link unlocks and new upload batches, per
# client address. Requests whose key is empty (everything else) are not limited.
map "$request_method $uri" $relay_auth_limit {
    "~^POST /api/auth/"                $relay_client_ip;
    "~^POST /api/share/[^/]+/unlock$"  $relay_client_ip;
    default "";
}
map "$request_method $uri" $relay_upload_limit {
    "POST /api/uploads" $relay_client_ip;
    default "";
}
limit_req_zone $relay_auth_limit zone=relay_auth:10m rate=20r/m;
limit_req_zone $relay_upload_limit zone=relay_uploads:10m rate=60r/m;

# No client addresses in Nginx logs (same rule as the app's logs).
log_format relayfiles '[$time_local] "$request" $status $body_bytes_sent $request_time';

server {
    listen 8080;
    server_name ${SERVER_NAME};
    server_tokens off;
    access_log /dev/stdout relayfiles;

    # Uploads arrive in tus chunks of UPLOAD_CHUNK_SIZE_MB (at most 95 MB).
    client_max_body_size 100m;

    sendfile on;
    tcp_nopush on;

    # Over the limits above: the API's own error format, so the app shows its usual message.
    limit_req_status 429;
    error_page 429 = @relay_rate_limited;
    location @relay_rate_limited {
        default_type application/json;
        add_header Retry-After 60 always;
        return 429 '{"success":false,"error":"Too many requests. Try again later.","code":"RATE_LIMITED"}';
    }

    # When the app is down or the server is in maintenance, Nginx answers with static pages.
    error_page 502 /_errors/502.html;
    error_page 503 /_errors/503.html;
    error_page 504 /_errors/504.html;
    location ^~ /_errors/ {
        internal;
        alias /usr/share/nginx/error/;
    }

    # Additional volumes (deploy/nginx/volumes/<volumeId>.conf, written by volume:init).
    include /etc/nginx/volumes/*.conf;

    # Files are sent by Nginx after the app has checked access (X-Accel-Redirect):
    # ${STORAGE_ACCEL_PREFIX}<volumeId>/<accountId>/<path> → ${STORAGE_ROOT}/users/<accountId>/<path>
    location ~ ^${STORAGE_ACCEL_PREFIX}[a-z0-9-]+/(.+)$ {
        internal;
        alias ${STORAGE_ROOT}/users/$1;
        # The app checked the path with lstat, but Nginx opens it again: refuse a symlink that
        # appeared in between (below STORAGE_ROOT; the mount point itself may be one).
        disable_symlinks on from=${STORAGE_ROOT};
        # Cache-Control comes from the app (kept by X-Accel-Redirect): playback is cacheable,
        # downloads are not. Adding one here would send two and disable the browser cache.
        add_header X-Content-Type-Options nosniff always;
    }

    # Resumable uploads stream straight to the app.
    location ^~ /api/uploads/tus {
        if (-f /etc/nginx/maintenance/on) { return 503; }
        proxy_pass http://relayfiles_app;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $relay_client_ip;
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header X-Forwarded-For $relay_client_ip;
        proxy_set_header X-Forwarded-Proto $relay_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location / {
        # Maintenance mode: touch deploy/maintenance/on (remove it to come back). The health
        # probe stays reachable so a release can confirm the new version before lifting it.
        set $relay_maintenance "";
        if (-f /etc/nginx/maintenance/on) { set $relay_maintenance on; }
        if ($uri = /api/health) { set $relay_maintenance ""; }
        if ($relay_maintenance) { return 503; }
        limit_req zone=relay_auth burst=20 nodelay;
        limit_req zone=relay_uploads burst=30 nodelay;
        proxy_pass http://relayfiles_app;
        # Next.js internals the browser never needs (a proxy rewrite names the upstream address).
        proxy_hide_header X-Middleware-Rewrite;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $relay_client_ip;
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header X-Forwarded-For $relay_client_ip;
        proxy_set_header X-Forwarded-Proto $relay_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        # Streams, zips and the Server page's live updates can run long.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}
