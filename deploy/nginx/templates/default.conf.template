# RelayFiles behind Nginx (rendered by the nginx image's envsubst at start-up; values come
# from .env through docker compose). Nginx variables ($host, $1, …) are left untouched.
# The site itself (locations, limits, error pages) is relayfiles-site.inc.template, included by
# the two server blocks at the end of this file.

# The cluster's DNS (Docker: 127.0.0.11, k3s: the kube-dns service): the app gets a new
# address whenever a release recreates it, so the upstream is resolved again instead of being
# fixed at start-up.
resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

upstream relayfiles_app {
    zone relayfiles_app 64k;
    server ${APP_UPSTREAM} resolve;
    keepalive 16;
}

# The real client address: only cloudflared (fixed address on the compose network) may
# set it through CF-Connecting-IP. Everyone else is identified by the TCP peer.
set_real_ip_from ${CLOUDFLARED_IP};
real_ip_header CF-Connecting-IP;

# A proxy on the host (host Nginx → NGINX_LISTEN_HOST:NGINX_LISTEN_PORT) reaches this container
# from the Docker gateway. Only that peer (TRUSTED_PROXY_IP) may name the client through
# X-Real-IP; the header from any other peer is ignored.
geo $realip_remote_addr $relay_from_host_proxy {
    default 0;
    ${TRUSTED_PROXY_IP} 1;
}
map "$relay_from_host_proxy|$http_x_real_ip" $relay_client_ip {
    "~^1\|(?<client>[0-9A-Fa-f.:]+)$" $client;
    default $remote_addr;
}

# The scheme the visitor used: only cloudflared and the trusted host proxy may say it through
# X-Forwarded-Proto (the app and tus build URLs from it); anyone else gets this hop's scheme.
geo $realip_remote_addr $relay_trusted_peer {
    default 0;
    ${CLOUDFLARED_IP} 1;
    ${TRUSTED_PROXY_IP} 1;
}
map "$relay_trusted_peer|$http_x_forwarded_proto" $relay_proto {
    "~^1\|(?<proto>https?)$" $proto;
    default $scheme;
}

# First line of defense before the app's own Redis limits (and before argon2 checks link
# passwords): sign-in, sign-up, account switching, link unlocks and new upload batches, per
# client address. Requests whose key is empty (everything else) are not limited.
map "$request_method $uri" $relay_auth_limit {
    "~^POST /api/auth/"                $relay_client_ip;
    "~^POST /api/share/[^/]+/unlock$"  $relay_client_ip;
    default "";
}
map "$request_method $uri" $relay_upload_limit {
    "POST /api/uploads" $relay_client_ip;
    default "";
}
# Personal API token requests: a token with a known id but a wrong secret costs an argon2 check
# in the app before its own per-token limit, so Nginx limits them per client address first.
map $uri $relay_api_limit {
    "~^/api/v1/" $relay_client_ip;
    "/metrics"   $relay_client_ip;
    default "";
}
limit_req_zone $relay_auth_limit zone=relay_auth:10m rate=${NGINX_AUTH_RATE_PER_MIN}r/m;
limit_req_zone $relay_upload_limit zone=relay_uploads:10m rate=${NGINX_UPLOAD_RATE_PER_MIN}r/m;
limit_req_zone $relay_api_limit zone=relay_api:10m rate=${NGINX_API_RATE_PER_MIN}r/m;

# No client addresses in Nginx logs (same rule as the app's logs).
log_format relayfiles '[$time_local] "$request" $status $body_bytes_sent $request_time';

# Host names. SERVER_NAME, and 127.0.0.1 (the release script's health check through this Nginx),
# reach the site through the first server. Any other Host header lands on the default server: with
# SERVER_NAME=_ (every name) it serves the same site; otherwise Nginx closes the connection
# without an answer (444), so a page on another domain that resolves to this server (DNS
# rebinding) or a scanner using the bare address never reaches the app.
map "${SERVER_NAME}" $relay_reject_unknown_host {
    "_"     "";
    default 1;
}

server {
    listen 8080;
    server_name ${SERVER_NAME} 127.0.0.1;
    include /etc/nginx/conf.d/relayfiles-site.inc;
}

server {
    listen 8080 default_server;
    server_name "";
    if ($relay_reject_unknown_host) {
        return 444;
    }
    include /etc/nginx/conf.d/relayfiles-site.inc;
}
