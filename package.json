{
  "name": "relayfiles",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start-server.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "playwright test",
    "check:emoji": "node scripts/check-no-emoji.mjs",
    "check:cycles": "node scripts/check-feature-cycles.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:emoji && npm run check:cycles && npm run check:migrations && npm run test && npm run build",
    "env:check": "tsx scripts/env-check.mts",
    "env:secrets": "node scripts/env-secrets.mjs",
    "postinstall": "prisma generate",
    "test:integration": "vitest run --project integration",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "volume:init": "tsx --conditions=react-server scripts/volume-init.mts",
    "admin:create": "tsx --conditions=react-server scripts/admin-create.mts",
    "worker": "node --import tsx --conditions=react-server scripts/worker.mts",
    "media:backfill": "tsx --conditions=react-server scripts/media-backfill.mts",
    "deploy:error-pages": "tsx scripts/build-error-pages.mts",
    "data:migrate": "tsx --conditions=react-server scripts/data-migrate.mts",
    "keys:rotate": "tsx --conditions=react-server scripts/keys-rotate.mts",
    "check:migrations": "node scripts/check-migrations.mjs",
    "storage:migrate": "tsx --conditions=react-server scripts/storage-migrate.mts",
    "storage:import": "tsx --conditions=react-server scripts/storage-import.mts",
    "backup:verify": "tsx --conditions=react-server scripts/backup-verify.mts",
    "storage:fsck": "tsx --conditions=react-server scripts/storage-fsck.mts",
    "volume:migrate": "tsx --conditions=react-server scripts/volume-migrate.mts",
    "volume:list": "tsx --conditions=react-server scripts/volume-list.mts",
    "volume:remove": "tsx --conditions=react-server scripts/volume-remove.mts"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@next/env": "^16.4.3",
    "@node-rs/argon2": "^2.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.6",
    "archiver": "^8.0.0",
    "bullmq": "^6.3.11",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "file-type": "^22.1.1",
    "highlight.js": "^11.12.0",
    "ioredis": "^6.0.0",
    "mammoth": "^1.13.0",
    "next": "16.4.3",
    "pdfjs-dist": "^6.4.299",
    "pretendard": "^1.3.9",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "read-excel-file": "^9.3.12",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "systeminformation": "^5.33.16",
    "tailwind-merge": "^3.7.0",
    "tar-stream": "^3.2.2",
    "tsx": "^4.23.15",
    "tus-js-client": "^4.3.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tar-stream": "^3.1.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "description": "Private file drop for sharing and streaming media from a self-hosted server",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "overrides": {
    "mysql2": "^3.24.5",
    "deepmerge-ts": "^8.0.2"
  }
}
