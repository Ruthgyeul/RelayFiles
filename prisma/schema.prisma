// RelayFiles data model (docs/architecture.md "데이터 저장소").
// PostgreSQL is the index of the file tree and all metadata; file bytes live on the
// storage volume (/mnt/relayfilesDB) under users/<accountId>/ with the same folder names.

generator client {
  provider     = "prisma-client"
  output       = "../src/server/db/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Storage volumes
// ---------------------------------------------------------------------------

enum StorageDriver {
  LOCAL
  S3
}

enum VolumeStatus {
  ACTIVE
  READONLY
  DRAINING
  OFFLINE
}

/// A storage location (external SSD mount or object store). Accounts are assigned to one.
model StorageVolume {
  id            String        @id
  driver        StorageDriver @default(LOCAL)
  /// Absolute mount path for LOCAL volumes, bucket URL for S3.
  mountPath     String
  status        VolumeStatus  @default(ACTIVE)
  /// Directory layout version; must match the code (docs/runbook.md "스토리지 레이아웃").
  layoutVersion Int           @default(1)
  reservePct    Int           @default(5)
  createdAt     DateTime      @default(now())
  accounts      Account[]
}

// ---------------------------------------------------------------------------
// Accounts and sessions
// ---------------------------------------------------------------------------

/// Anonymous token account. The token is stored encrypted (shown in full on the profile)
/// and as an HMAC for lookup; the plain token never touches the database.
model Account {
  id                   String        @id
  name                 String        @unique
  tokenLookup          String        @unique
  tokenEnc             Bytes
  color                String
  isAdmin              Boolean       @default(false)
  neverExpire          Boolean       @default(false)
  /// Explicit deletion date set by an admin; null = createdAt + ACCOUNT_TTL_DAYS.
  expiresAt            DateTime?
  /// Storage quota in bytes; null = unlimited.
  quotaBytes           BigInt?
  stripMetadataOnShare Boolean       @default(true)
  /// True while the account's files are being moved to another volume.
  migrating            Boolean       @default(false)
  volumeId             String
  volume               StorageVolume @relation(fields: [volumeId], references: [id])
  createdAt            DateTime      @default(now())
  lastLoginAt          DateTime      @default(now())
  sessions             Session[]
  nodes                Node[]
  trashed              TrashedBytes[]
  traffic              TrafficDaily[]
  apiTokens            ApiToken[]
  fileRequests         FileRequest[]

  @@index([volumeId])
}

/// One signed-in device for an account.
model Session {
  id         String    @id
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  os         String
  browser    String
  country    String?
  city       String?
  /// IP with the last two octets masked (a.b.•••.•••); the real IP is never stored.
  ipMasked   String
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  /// When the account token was last entered on this session (re-authentication for admin
  /// actions); null = only at sign-in (createdAt).
  reauthAt   DateTime?

  @@index([accountId])
}

/// Admin actions, for "who changed what": roles, deletions, sign-up mode, cleanups, invites.
/// The actor's name is copied so the entry stays readable after the account is deleted.
model AuditEvent {
  id        String   @id
  actorId   String
  actorName String
  action    String
  /// The account, invite code or setting the action was about.
  targetId  String?
  /// Short client-safe detail, e.g. the new sign-up mode.
  detail    String?
  /// IP with the last two octets masked; the real IP is never stored.
  ipMasked  String
  at        DateTime @default(now())

  @@index([at])
}

// ---------------------------------------------------------------------------
// File tree
// ---------------------------------------------------------------------------

enum NodeType {
  FOLDER
  FILE
}

enum FileKind {
  VIDEO
  AUDIO
  IMAGE
  OTHER
}

enum Visibility {
  INHERIT
  PRIVATE
  PUBLIC
}

enum Access {
  BOTH
  STREAM
}

/// A folder or file. Each account has exactly one root folder (parentId = null), created
/// together with the account; the root maps to users/<accountId>/ on the volume.
model Node {
  id            String      @id
  accountId     String
  account       Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  parentId      String?
  parent        Node?       @relation("NodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      Node[]      @relation("NodeTree")
  type          NodeType
  /// File or folder name, identical to the name on disk (validated by domain/names.ts).
  name          String
  kind          FileKind?
  mime          String?
  size          BigInt      @default(0)
  sha256        String?
  hasThumb      Boolean     @default(false)
  hasDerived    Boolean     @default(false)
  /// The worker could not make the metadata-stripped copy (undecodable or too large): visitors get 415, not a retry.
  stripFailed   Boolean     @default(false)
  /// Set by the reconcile job when the file is missing on disk.
  missing       Boolean     @default(false)
  /// Public link id (/d/<linkId>). Never changes during migrations; regenerated only on request.
  linkId        String      @unique
  visibility    Visibility  @default(INHERIT)
  expiryLabel   String      @default("Never")
  expAt         DateTime?
  burn          Boolean     @default(false)
  downloadLimit Int?
  passwordHash  String?
  access        Access      @default(BOTH)
  note          String      @default("")
  dlPaused      Boolean     @default(false)
  downloads     Int         @default(0)
  tags          String[]    @default([])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  /// When the file's content last changed, as the uploader reported it (File.lastModified); files without it use the disk mtime (data migration 20261101-backfill-modified-at).
  modifiedAt    DateTime?
  events        LinkEvent[]
  fileRequests  FileRequest[]

  @@unique([parentId, name])
  @@index([accountId, parentId])
  @@index([accountId, type])
  /// Finds a file with the same content in the account (deduplication of re-uploads).
  @@index([accountId, sha256])
  @@index([expAt])
  @@index([tags], type: Gin)
}

enum LinkEventKind {
  OPEN
  PLAY
  VIEW
  DOWNLOAD
  RESET
}

/// Share link activity (opens, plays, downloads, link resets). The newest 200 per node are kept.
model LinkEvent {
  id        BigInt        @id @default(autoincrement())
  nodeId    String
  node      Node          @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  kind      LinkEventKind
  fileName  String
  device    String        @default("")
  ipMasked  String        @default("")
  country   String        @default("")
  at        DateTime      @default(now())

  @@index([nodeId, at])
}

/// Bytes served per account per day (profile "Traffic" card).
model TrafficDaily {
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  bytes     BigInt   @default(0)

  @@id([accountId, day])
}

// ---------------------------------------------------------------------------
// Server administration
// ---------------------------------------------------------------------------

enum SignupMode {
  OPEN
  INVITE
  CLOSED
}

/// Singleton row (id = 1) with settings an admin changes at runtime.
model ServerConfig {
  id         Int        @id @default(1)
  signupMode SignupMode @default(OPEN)
  /// Theme key overriding DEFAULT_THEME; null = use the env default.
  theme      String?
  updatedAt  DateTime   @updatedAt
}

/// One-time invite code for INVITE sign-up mode.
model Invite {
  code       String    @id
  createdAt  DateTime  @default(now())
  usedAt     DateTime?
  usedByName String?
}

enum AnnouncementLevel {
  INFO
  WARN
  MAINT
}

model Announcement {
  id    String            @id
  text  String
  level AnnouncementLevel @default(INFO)
  live  Boolean           @default(true)
  at    DateTime          @default(now())
}

enum IncidentSeverity {
  MINOR
  MAJOR
  MAINT
}

model Incident {
  id        String           @id
  title     String
  text      String           @default("")
  severity  IncidentSeverity @default(MINOR)
  date      DateTime
  duration  String           @default("")
  resolved  Boolean          @default(false)
  createdAt DateTime         @default(now())
}

// ---------------------------------------------------------------------------
// Health history (Status page)
// ---------------------------------------------------------------------------

/// Raw per-minute probe results, rolled up into hourly and daily rows.
model HealthSample {
  id        BigInt   @id @default(autoincrement())
  component String
  at        DateTime @default(now())
  ok        Boolean
  ms        Int?

  @@index([component, at])
}

model HealthHourly {
  component String
  hour      DateTime
  okCount   Int      @default(0)
  failCount Int      @default(0)
  avgMs     Int?
  p95Ms     Int?

  @@id([component, hour])
}

enum HealthLevel {
  OK
  WARN
  DOWN
}

model HealthDaily {
  component String
  day       DateTime    @db.Date
  level     HealthLevel
  okCount   Int         @default(0)
  failCount Int         @default(0)

  @@id([component, day])
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

/// Share links whose items were deleted because they expired (own expiry, delete after
/// download, or the account's deletion date). Visitors then see "This link has expired"
/// instead of "Link not found". Kept for SHARE.tombstoneDays.
model LinkTombstone {
  linkId  String   @id
  endedAt DateTime @default(now())

  @@index([endedAt])
}

/// Progress of resumable data migrations (src/server/migrations, docs/runbook.md "데이터 마이그레이션").
model DataMigration {
  id         String    @id
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  cursor     String?
}

/// Bytes of deleted files waiting in a volume's trash (system/trash). They still take disk space, so
/// they count toward the account's storage until the daily job removes the trash for good.
model TrashedBytes {
  id        String   @id
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  bytes     BigInt
  trashedAt DateTime @default(now())

  @@index([accountId])
  @@index([trashedAt])
}

/// One run of deploy/scripts/verify-backup.sh: the newest dump restored into a scratch database
/// and compared with production, plus a report-only storage:fsck. The Server page shows the latest.
model BackupCheck {
  id              BigInt    @id @default(autoincrement())
  checkedAt       DateTime  @default(now())
  ok              Boolean
  /// File name of the dump that was restored (null when none was found).
  dumpName        String?
  dumpAt          DateTime?
  restoreMs       Int?
  /// Items storage:fsck found different between the database and the volumes.
  fsckDifferences Int?
  /// What failed, in words for the Server page (empty when ok).
  problems        String[]

  @@index([checkedAt])
}

/// Personal API token for scripts and uploaders (Authorization: Bearer on /api/v1). Shown once;
/// only its SHA-256 is stored (256 random bits need no key, so key rotation never breaks it).
/// Revoking deletes the row.
model ApiToken {
  id         String    @id
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name       String
  /// argon2id hash of the whole token (rfp_<id>_<secret>); the token itself is never stored.
  secretHash String
  /// What the token may do (contracts/api-tokens.ts API_SCOPES).
  scopes     String[]
  createdAt  DateTime  @default(now())
  /// Null: until revoked.
  expiresAt  DateTime?
  lastUsedAt DateTime?

  @@index([accountId])
}

/// Upload-only link ("file request", /r/<id>): visitors add files to one folder of the account
/// without seeing what is in it. Deleting the folder deletes its requests.
model FileRequest {
  id            String    @id
  accountId     String
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  folderId      String
  folder        Node      @relation(fields: [folderId], references: [id], onDelete: Cascade)
  /// Shown to uploaders ("Photos from the trip").
  title         String
  /// argon2id, like share link passwords; null = no password.
  passwordHash  String?
  expiresAt     DateTime?
  /// Limits for everything received through this link; null = no limit.
  maxFiles      Int?
  maxBytes      BigInt?
  filesReceived Int       @default(0)
  bytesReceived BigInt    @default(0)
  createdAt     DateTime  @default(now())

  @@index([accountId])
  @@index([folderId])
}
